    {
      "segment_id": "5f99abeb1ee41728bb7db4dd",
      "document_id": "cebd3e59c585567b2b64dde5",
      "segment_kind": "paragraph",
      "index": "30",
      "locator": "paragraph 30",
      "text": "New York has always been the place where dreamers come to build a future. But today too many New Yorkers feel like no matter how hard they work, they can’t get ahead. Jenifer is living testament that the American Dream is alive and possible, and she’s committed to a life of service to restore the promise of opportunity — so that every New Yorker has a real shot at success . As the daughter of immigrants, trailblazing civil rights attorney, and first South Asian woman ever elected to office in State history, she will create opportunities for every New Yorker—so that more dreams are realized in our city and state.",
      "sha256": "8303ea369126af81e608e4068fbd385a5d27510e79548315e86c6faf73c7207d"
    },
    {
      "segment_id": "df70e0d98214fa9c7d25cf63",
      "document_id": "cebd3e59c585567b2b64dde5",
      "segment_kind": "paragraph",
      "index": "31",
      "locator": "paragraph 31",
      "text": "Protecting Our Freedoms and Defending Equality",
      "sha256": "888b1a5ed2d41dd982de79702bac05966b5fab342c0c721dbb1ef8ea5127651a"
    },
    {
      "segment_id": "08b9f7041943091b3d5250d6",
      "document_id": "cebd3e59c585567b2b64dde5",
      "segment_kind": "paragraph",
      "index": "32",
      "locator": "paragraph 32",
      "text": "As a civil rights lawyer with a proven track record, Jenifer will fight for the rights and dignity of everyone, in New York and across the country.",
      "sha256": "1259dd41d576c77a78a8f4b6b42fffa377819cb0b45233c9fad364f9ea90d2a4"
    },
