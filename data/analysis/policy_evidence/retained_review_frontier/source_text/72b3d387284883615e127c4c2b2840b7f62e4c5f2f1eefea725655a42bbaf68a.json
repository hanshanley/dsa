      "text": "Cindy Bass (Democrat)",
      "sha256": "fcb8341510f02115ff4bc5e69587336919a94d60837860c5e645feec3c287d40"
    },
    {
      "segment_id": "6db4f6371d218427e6fd990f",
      "document_id": "33795e946f841d7f0ac71155",
      "segment_kind": "paragraph",
      "index": "63",
      "locator": "paragraph 63",
      "text": "(Incumbent)",
      "sha256": "efd96482c91c747caacfba3aa7861ed91cd2b3fe3163e38da87b150c6366c88b"
    },
    {
      "segment_id": "bffbdd8ce3d9ea606e24bc83",
