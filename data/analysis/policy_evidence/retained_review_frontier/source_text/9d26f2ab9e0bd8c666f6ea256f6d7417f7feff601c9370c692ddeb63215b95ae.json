    },
    {
      "segment_id": "ec8c6b84676fe34e904e326f",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "37",
      "locator": "paragraph 37",
      "text": "Why I’m Running",
      "sha256": "54e0f0baf0162cd854cebe57eb252b8e2e8adc5f014ec740a9b5364e284b4743"
    },
    {
      "segment_id": "9761c090b13db6614f83ecc7",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "38",
      "locator": "paragraph 38",
      "text": "I’m running for Justice of the Peace because representation matters. The people of Travis County deserve a judge who not only understands the law but also understands the challenges faced by those in our community.",
      "sha256": "44f915ca03311edb0cc01193e0c51b9ea95cbdd757b527d17935912752da6013"
    },
    {
      "segment_id": "a7a848f0bcee769d0c7f7d93",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "39",
      "locator": "paragraph 39",
      "text": "I’ve seen firsthand how the justice system affects people and families, both in my professional work and in my personal life. As the daughter of a mother who worked tirelessly to raise four children, and as someone whose family has been impacted by addiction and incarceration, I know what it means to struggle and overcome.",
      "sha256": "e4ef11171f32cbd589b764680f293f4c0301fc40fca3ae44ea25dc40dde561f2"
    },
    {
      "segment_id": "63b252ffa78ad41769a8051f",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "40",
      "locator": "paragraph 40",
      "text": "The Justice of the Peace Court is often where people have their first interaction with the legal system. I want to ensure that experience is rooted in fairness, dignity, and understanding.",
      "sha256": "ee4d21fdac4733cec33a0762add43afb64d028290908069252da45fb4dbb45c9"
    },
    {
      "segment_id": "d9f6478e647caae0d02a0d45",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "41",
      "locator": "paragraph 41",
      "text": "Meet Ciara",
      "sha256": "fb83be1c681af20b15063e301e8171f36d6613a82f93ef85a1aaa990d5315c4e"
    },
    {
      "segment_id": "fdcb490c596951dd18e729c2",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "42",
      "locator": "paragraph 42",
      "text": "Ciara Parks is a dedicated public servant, veteran attorney, and proud mother running to serve as Justice of the Peace for Precinct 1. With more than a decade of legal experience as a prosecutor and public servant, Ciara will bring both professional expertise and lived experience to the bench.",
      "sha256": "682d82701d0c5cbfc9184913af0a599270713b073b9fd88dc06561728dad7d3d"
    },
    {
      "segment_id": "73c53ee2645a5367c5a01b66",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "43",
      "locator": "paragraph 43",
      "text": "She currently serves as General Counsel for the Travis County Juvenile Probation Department and as Associate Judge for the City of Manor. Ciara was raised by a single mother and was the first in her family to graduate from college and law school.",
      "sha256": "4c719c86e8cbbaeda173209fc462b8e73e9ca35178d496625a43bdacb6d5d782"
    },
    {
      "segment_id": "79ebedfe119e2ed13a946281",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "44",
      "locator": "paragraph 44",
      "text": "Priorities",
      "sha256": "980477c4e0b07988b5b5a7cf92d956e812702510f13dd66f11c1501031862628"
    },
    {
      "segment_id": "74faad7f14b7dd695dbc0bb4",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "45",
      "locator": "paragraph 45",
      "text": "Fair & Compassionate Justice",
      "sha256": "3495d92803835021e6e3ccabea0531e65d731c061d4bec1ca92b5a8f92fbe9cc"
    },
    {
      "segment_id": "fb10746266a22da91ddd36d2",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "46",
      "locator": "paragraph 46",
      "text": "Ciara will ensure every person who enters her courtroom is treated with dignity and respect, regardless of background or circumstance.",
      "sha256": "47d17b4b54a4d55e74ebffea9274e9f1d4de94edd0657f91f20120e491238bdf"
    },
    {
      "segment_id": "556bc4d147a4a88aa29f41ae",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "47",
      "locator": "paragraph 47",
      "text": "Mental Health & Substance Use Support",
      "sha256": "7165619a807dda72fbc3ea5ca6b71fd223d5b3df4d7a59a00d724149578efd79"
    },
    {
      "segment_id": "3fe422fa03155c8718a706c3",
      "document_id": "b03005607843df892c566a0a",
      "segment_kind": "paragraph",
      "index": "48",
      "locator": "paragraph 48",
      "text": "Ciara understands the importance of addressing the root causes of many encounters with the justice system and will advocate for alternatives to incarceration when appropriate.",
      "sha256": "6c4b91795cf18096028ee756137fd693e2402b20f711a67e56e4ded0cc08c96c"
    },
    {
