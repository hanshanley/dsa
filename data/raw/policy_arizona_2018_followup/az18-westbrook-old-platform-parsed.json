    {
      "segment_id": "db1994914c6be4c811f8a941",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "27",
      "locator": "paragraph 27",
      "text": "Our Platform",
      "sha256": "272f67b270963b19bf409289e64e60fb82c95d2e1a7cb27c4f1962324397d99c"
    },
    {
      "segment_id": "ee2f8418bd028ae48d6023cc",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "28",
      "locator": "paragraph 28",
      "text": "To represent the voting constituents of this district and not special interest",
      "sha256": "f0661380f7a5a0f6de11e77fac39b192c6960394af58eadb01fd0cf9b0110f10"
    },
    {
      "segment_id": "a5999f279f7e1df986e7c58f",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "29",
      "locator": "paragraph 29",
      "text": "Women's issues",
      "sha256": "b6cf4fe4518bddcd140465b671397dca995491ba8fcbbffc6f55c3f64f79c48c"
    },
    {
      "segment_id": "c6aa5be0ad4f1eb6e8b567d8",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "30",
      "locator": "paragraph 30",
      "text": "Create college grants for women pursuing careers in the sciences, engineering and technology.",
      "sha256": "d28f378b6846f8a09f5b4e1c8dc9e09456e588bbc4ed25b846c42bcc5c657f20"
    },
    {
      "segment_id": "cfaa42974c1bca5129e8e03c",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "31",
      "locator": "paragraph 31",
      "text": "Championing to protect women against job discrimination.",
      "sha256": "8becb549aa1f6c0dd4568aa973556e62767a2a8b44b462f40fa0230b767ee1c6"
    },
    {
      "segment_id": "85fb98aa1ce9c894367e2742",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "32",
      "locator": "paragraph 32",
      "text": "Working to protect women’s reproductive rights, choosing the terms they choose to procreate, and supporting healthcare as a right, not a privilege.",
      "sha256": "38fa66b4a18a530a9c3a2598a6c759aeb7133dc50d9037d3930fc98f7885cdf5"
    },
    {
      "segment_id": "8d319f68e6b7d5c9a06cf354",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "33",
      "locator": "paragraph 33",
      "text": "Eliminate racial injustices for women of color.",
      "sha256": "61b96556a363f9fd2b250e24f0faa7b1322c0df901a20270de0d8a0f45eb815d"
    },
    {
      "segment_id": "ff368bd2de465ff415992b7c",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "34",
      "locator": "paragraph 34",
      "text": "Support legislation to end domestic and sexual violence against women.",
      "sha256": "a618c9b78d9eb3d796a991530763853ea9d1ed05bf99cfadc6134e5db5cedec2"
    },
    {
      "segment_id": "b1ca464e94908bdebbe60365",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "35",
      "locator": "paragraph 35",
      "text": "Education",
      "sha256": "512ab3c6b9869577bd4474c56b88f9e3f1c40c54d18e8e5a2329821254d362d2"
    },
    {
      "segment_id": "5b392c47586934f564571e91",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "36",
      "locator": "paragraph 36",
      "text": "Support free tuition Community College and State Universities",
      "sha256": "abfe4e837b074378db5208473c3200673b5cbcd04f3c707c1c45686bc534f5dc"
    },
    {
      "segment_id": "cf77661691bb871f20222bbc",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "37",
      "locator": "paragraph 37",
      "text": "Forgive student loans for current teachers.",
      "sha256": "279d47f628a7c40dde3d98edf1c340f7de7ab98bd5209eaadf7f865fa8c6bb6e"
    },
    {
      "segment_id": "2b9e41e10e749098972e7cd3",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "38",
      "locator": "paragraph 38",
      "text": "Support school involvement for civic engagement.",
      "sha256": "b9d993afe9f5b5ba4d8373c19f36f85c0921de898c9307f24e12f5066f3ab97a"
    },
    {
      "segment_id": "a4fa3ae21d1dc2b48c1d3bef",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "39",
      "locator": "paragraph 39",
      "text": "Protect the Arts as an integral part of educational curriculum.",
      "sha256": "b372589380b877a2e89a781bd713f36db1f2d19a380e7d372d402607845d04cc"
    },
    {
      "segment_id": "8071748a8c5a53e1c8f7b451",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "40",
      "locator": "paragraph 40",
      "text": "Enact legislation to pay teachers a living wage commensurate with their educational responsibilities.",
      "sha256": "e9ca8135a8e4b13c6390a17261ddaa6016558ca5c25c8467baad5fd4f24772dc"
    },
    {
      "segment_id": "c477e0524aff442a7edb2dba",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "41",
      "locator": "paragraph 41",
      "text": "Engage in supporting low income schools with funding to promote replenishing retiring educators.",
      "sha256": "5eb3e1e3424561d8a1a9e33193e8e760b0db0a0ac557b8c560775e5b867d1a99"
    },
    {
      "segment_id": "4e74b2140d6b38c10ec623cf",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "42",
      "locator": "paragraph 42",
      "text": "Clean Energy",
      "sha256": "995b9fc00115e7b73b32e3cddf85851b2539f30fd4975a431dbb0dd678bc4f12"
    },
    {
      "segment_id": "280dc40d4f0601482ba8f614",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "43",
      "locator": "paragraph 43",
      "text": "Create legislation to incentivize business owners to convert to clean renewable energy.",
      "sha256": "49d3f6d0582c3db1d63663fbee8c98e30184f89d7dab023c5d9904c950f03547"
    },
    {
      "segment_id": "311fb3ff3ba844fa4ace9c09",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "44",
      "locator": "paragraph 44",
      "text": "Reward home and business owners that utilize renewable energy.",
      "sha256": "d7a4f2c0b7d8cc3f493ea944b4359df2d6c6866cf73745d90e9f55dc85435963"
    },
    {
      "segment_id": "d610c4df240646b3b6321bba",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "45",
      "locator": "paragraph 45",
      "text": "Fund research for clean renewable energy alternatives to bring overall costs down.",
      "sha256": "3a5f8da07bce53aaf782b848da146c5b1b64e95b2d09851322bcb2e8cef3d047"
    },
    {
      "segment_id": "c4de141e7dfc87ba65949eed",
      "document_id": "az18-westbrook-old-platform",
      "segment_kind": "paragraph",
      "index": "46",
      "locator": "paragraph 46",
      "text": "Paid for by Westbrook for Congress 2018 - Arizona District 8",
      "sha256": "64d818b16914f7eb37e8308db5778c6027ed4dc10a9c67227aaa37408c49684f"
    },
    {
      "segment_id": "695b55cf318edde4c8941810",
