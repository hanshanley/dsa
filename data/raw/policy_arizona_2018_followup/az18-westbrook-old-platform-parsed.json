      "segment_kind": "paragraph",
      "index": "47",
      "locator": "paragraph 47",
      "text": "Powered by The People of Arizona",
      "sha256": "46a55a6b6c722be0991f3f9d39887b8a4767a5049932d1b1d2babcd20a638336"
    }
  ]
