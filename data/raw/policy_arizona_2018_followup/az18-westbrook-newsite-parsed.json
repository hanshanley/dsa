      "sha256": "c3476b1d4bbd578cc8520fb5e2de1f584383c464bc0a23ee06c9ba963f0e71cf"
    },
    {
      "segment_id": "8ac71eb68f20604d5813b63b",
      "document_id": "az18-westbrook-newsite",
      "segment_kind": "paragraph",
      "index": "76",
      "locator": "paragraph 76",
      "text": "The 2017 election of Donald Trump resulted in the Women’s March on Washington, a surge of over four million women and men who took to the streets of America. They gathered to raise a loud,",
      "sha256": "1261e0e2c602e1367192042aff63cf0d16e791f66b590e3691dda935330d5770"
    },
