      "text": "The Women’s March, 2018",
      "sha256": "dea3fb2d0e9abd50a562041048254552912be9094f38281c81823a62ee88af7c"
    },
    {
      "segment_id": "b38efef3fc0c9da0112adbb8",
      "document_id": "az18-westbrook-newsite",
      "segment_kind": "paragraph",
      "index": "75",
