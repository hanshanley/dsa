    {
      "segment_id": "e59f20913e9cb01ed3a5c1a0",
      "document_id": "az18-westbrook-newsite",
      "segment_kind": "paragraph",
      "index": "26",
      "locator": "paragraph 26",
      "text": "\"As a courageous leader and U.S. House Candidate for Arizona's 8th District, Brianna Westbrook fights for social and economic justice and environmental preservation, as she works to return America to a nation of equal opportunities for all.\"",
      "sha256": "3fcab784fd5e5667d0c4e573887e8de5f03ab5611ca559b7d72c5821d3f0ef84"
    },
    {
      "segment_id": "955102430b03f7b45b4c2a25",
      "document_id": "az18-westbrook-newsite",
      "segment_kind": "paragraph",
      "index": "27",
      "locator": "paragraph 27",
      "text": "\"I am honored to become a Justice Democrat and join a slate with so many inspirational leaders and innovators committed to changing our future and restoring the strength of our democracy.\"",
      "sha256": "ec0e3272e94bd7a8c0647e41b5fbcd8d60ba51b17b3a46359a3cc8bb19ae38a0"
    },
