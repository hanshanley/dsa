string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/lp.org\/#organization","name":"Libertarian Party","url":"https:\/\/lp.org\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/lp.org\/#\/schema\/logo\/image\/","url":"https:\/\/lp.org\/wp-content\/uploads\/2024\/11\/cropped-lp-torch-logo-circle.png","contentUrl":"https:\/\/lp.org\/wp-content\/uploads\/2024\/11\/cropped-lp-torch-logo-circle.png","width":512,"height":512,"caption":"Libertarian Party"},"image":{"@id":"https:\/\/lp.org\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/libertarianparty","https:\/\/x.com\/lpnational","https:\/\/www.instagram.com\/libertarianparty"]}]}},"_links":{"self":[{"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/pages\/23","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/users\/8"}],"replies":[{"embeddable":true,"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/comments?post=23"}],"version-history":[{"count":0,"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/pages\/23\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/media\/1376462"}],"wp:attachment":[{"href":"https:\/\/lp.org\/wp-json\/wp\/v2\/media?parent=23"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}