<tbody><tr>
<td style="border-top-left-radius: 10px; -moz-border-radius-topleft: 10px; -webkit-border-top-left-radius: 10px; -khtml-border-top-left-radius: 10px; -icab-border-top-left-radius: 10px; -o-border-top-left-radius: 10px; border-top-right-radius: 10px; -moz-border-radius-topright: 10px; -webkit-border-top-right-radius: 10px; -khtml-border-top-right-radius: 10px; -icab-border-top-right-radius: 10px; -o-border-top-right-radius: 10px;; background: #6D6E71; color:#ffffff; font-size: 110%;" align="center" colspan="2"><b>2026 Libertarian National Convention</b>
</td></tr>
<tr style="text-align:center; vertical-align:middle; font-size:90%; background: #FFFFFF;">
<td colspan="2" style="width:100%;"><a href="/wiki/File:LNC-2026-Color-High-Rez.webp" class="image"><img alt="LNC-2026-Color-High-Rez.webp" src="https://mywikis-wiki-media.s3.us-central-1.wasabisys.com/lpedia/thumb/LNC-2026-Color-High-Rez.webp/300px-LNC-2026-Color-High-Rez.webp.png" decoding="async" width="300" height="157" srcset="https://mywikis-wiki-media.s3.us-central-1.wasabisys.com/lpedia/thumb/LNC-2026-Color-High-Rez.webp/450px-LNC-2026-Color-High-Rez.webp.png 1.5x, https://mywikis-wiki-media.s3.us-central-1.wasabisys.com/lpedia/thumb/LNC-2026-Color-High-Rez.webp/600px-LNC-2026-Color-High-Rez.webp.png 2x" data-file-width="1200" data-file-height="628" /></a>
</td></tr>
