	<style>
/*
 * Keep every social item aligned from the same top edge.
 */
.threads-custom-module li.et_pb_social_icon {
    vertical-align: top !important;
}

/*
 * Restore the Threads link to Divi's normal block layout.
 * The previous flex layout caused the item to shift vertically.
 */
.threads-custom-module li.threads-custom > a.icon {
    position: relative !important;
    display: block !important;
}

/*
 * Remove Divi's RSS icon.
 */
.threads-custom-module li.threads-custom > a.icon::before {
    content: none !important;
    display: none !important;
}

/*
 * Add the Threads logo as an absolutely centered mask.
 * Because it is absolutely positioned, it cannot alter alignment.
 */
.threads-custom-module li.threads-custom > a.icon::after {
    content: "" !important;

    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;

    display: block !important;
    width: 18px !important;
    height: 18px !important;

    background-color: #fed000 !important;

    -webkit-mask-image: url("https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/threads.svg");
    mask-image: url("https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/threads.svg");

    -webkit-mask-position: center;
    mask-position: center;

    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;

    -webkit-mask-size: contain;
    mask-size: contain;

    pointer-events: none;
}

/*
 * Remove the image inserted by the earlier version.
 */
.threads-custom-module .threads-custom-icon {
    display: none !important;
}
</style>

<script>
(function () {
    function installThreadsIcon() {
        const links = document.querySelectorAll(
            '.et_pb_social_media_follow a.icon[href*="threads.com"],' +
            '.et_pb_social_media_follow a.icon[href*="threads.net"]'
        );

        links.forEach(function (link) {
            const listItem = link.closest("li");
            const module = link.closest(".et_pb_social_media_follow");

            if (listItem) {
                listItem.classList.add("threads-custom");
            }

            if (module) {
                module.classList.add("threads-custom-module");
            }

            link.setAttribute("title", "Follow on Threads");
            link.setAttribute("aria-label", "Follow on Threads");
            link.setAttribute("rel", "noopener noreferrer");

            /*
             * Remove the old inserted image if it is still present.
             */
            link
                .querySelectorAll(".threads-custom-icon")
                .forEach(function (icon) {
                    icon.remove();
                });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", installThreadsIcon);
    } else {
        installThreadsIcon();
    }

    window.addEventListener("load", installThreadsIcon);

    /*
     * Allow for Divi rendering the module after initial page load.
     */
    const observer = new MutationObserver(installThreadsIcon);

    observer.observe(document.documentElement, {
        childList: true,
        subtree: true
    });

    window.setTimeout(function () {
        observer.disconnect();
    }, 15000);
})();
</script>

