<input type="submit" value="Sign Up &#8594;" name="">
</div>
</form>

<script>
jQuery(document).ready(function($){

$('.ngp-signup-footer').submit(function(e){
    
    e.preventDefault();
    
$.ajax({
    type: 'post',
    url: 'https://secure.ngpvan.com/v1/Forms/DudtBr48wEGb_c5gWyZL9A2',
    data: $('.ngp-signup-footer').serialize(),
    dataType: 'json',
    success: function (s) {
      console.log(s);
      window.location.href='https://secure.actblue.com/donate/latimer-web?refcode=signup-redirect';
    },
    error: function (f) {
      console.log(f);
      alert('Error submitting form.');
    }
  });

});

});  </script>		</div>
