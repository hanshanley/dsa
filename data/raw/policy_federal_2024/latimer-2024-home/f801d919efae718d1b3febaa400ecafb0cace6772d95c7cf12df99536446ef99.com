			<form action="https://secure.ngpvan.com/v1/Forms/DudtBr48wEGb_c5gWyZL9A2" method="POST" name="signup" class="ngp-signup-footer" accept-charset="utf-8" autocomplete="on" data-fastaction-endpoint="https://fastaction.ngpvan.com" data-inline-errors="true" data-fastaction-nologin="true" data-databag-endpoint="https://profile.ngpvan.com" data-databag="everybody" data-mobile-autofocus="false">
<input name="type" type="hidden" value="SignupForm" />
<div class="inputs clearfix">
    
<div class="firstname">
    <label>First Name</label>
<input type="text" placeholder="First Name" id="f1_firstname" name="FirstName" required="">
</div>  
<div class="lastname">
    <label>Last Name</label>
<input type="text" placeholder="Last Name" id="f1_lastname" name="LastName" required="">
