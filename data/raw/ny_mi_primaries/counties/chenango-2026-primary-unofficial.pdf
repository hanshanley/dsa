			var mobileHeader = $('.mobile.header', '#divToolbars');

			$('#divToolbars').empty()

			$('#divToolbars').append(mobileHeader);

			//Remove Alert Center Toolbar
			if ($('body').hasClass('shiftAlert')) {
				$('body').removeClass('shiftAlert');
			}

			if ($('body').hasClass('shiftAlertAndDashboard')) {
				$('body').removeClass('shiftAlertAndDashboard');
			}

			if ($('body').hasClass('shiftDashboard')) {
				$('body').removeClass('shiftDashboard');
			}

			$('#redirectToHome').bind('click', function (event) {
				event.preventDefault();

				window.location = '/';
			});
		});
	</script>

	




	






