957fccb":{"id":"ea0b4343-046b-441f-a2f7-55f81957fccb","data":{"fields":[{"name":"firstName","type":"input","label":"First Name","isUnique":true,"maxLength":20,"isRequired":true},{"name":"lastName","type":"input","label":"Last Name","isUnique":true,"maxLength":25,"isRequired":true},{"name":"email","type":"input","label":"Email","isUnique":true,"inputType":"email","isRequired":true},{"name":"phoneNumber","type":"input","label":"Phone Number","isUnique":true,"isRequired":true,"placeholder":"1-555-555-0000"},{"name":"zipOrPostalCode","type":"input","label":"ZIP Code","isUnique":true,"isRequired":true},{"name":"textarea","type":"textarea","label":"Send us a message!"}],"formId":"353b3895-26a9-4a5c-9e2e-724fa3d9382d","bgColor":"bg1","eyebrow":"reach out","headline":"\u003cp\u003eShare Your Vision for Illinois\u003c/p\u003e","wrapForm":false,"formWidth":20,"hasMargin":false,"marginTop":"top-large","blockStyle":"WHITE","description":"\u003cp\u003e\u003cstrong\u003eTell us about your ideas for a better Illinois.\u003c/strong\u003e I will be the first to admit that I don't know everything - far from it. I \u003cstrong\u003egenuinely \u003c/strong\u003ewant to hear from each one of you and I promise to personally read each one of your responses. \u003c/p\u003e","showEyebrow":false,"formProvider":"email","formWidthNew":10,"innerBgColor":"bg4","marginBottom":"bottom-large","submitBtnText":"Submit","showDescription":true},"type":"LONG_FORM","title":"Long Form","pageId":"06e4a5d2-7df1-4223-a82b-861e56788df3","siteId":"f683133e-6417-446e-ac39-6479efbabbee","deleted":false,"variant":"MULTI","createdAt":"2025-05-29T18:52:51.671+00:00","published":true,"updatedAt":"2026-03-02T16:51:03.873692+00:00","linkedBlockId":"66c04cf5-9324-4fce-8fde-a59979c34385","postStructure":[],"primaryBlockId":null,"lastTranslatedAt":null},"2270f9bc-b320-469b-afd7-893baa311f6f":{"id":"2270f9bc-b320-469b-afd7-893baa311f6f","data":{"image":"https://run.imgix.net/16a66b13-6e6e-4e6a-8d95-a2cfd4a1f1b1/933cfe10-0ba8-4161-808b-b179730bc30b/933cfe10-0ba8-4161-808b-b179730bc30b.jpeg?ixlib=js-3.8.0\u0026bri=0\u0026con=0\u0026sat=0\u0026high=0\u0026shad=0\u0026usm=0\u0026rect=0%2C203%2C8192%2C4686\u0026auto=compress%2Cformat\u0026fit=fillmax\u0026w=2048\u0026q=75","items":[{"url":"https://secure.actblue.com/donate/ryanforillinois","amount":"25"},{"url":"https://secure.actblue.com/donate/ryanforillinois","amount":"35"},{"url":"https://secure.actblue.com/donate/ryanforillinois","amount":"50"},{"url":"https://secure.actblue.com/donate/ryanforillinois","amount":"100"},{"url":"https://secure.actblue.com/donate/ryanforillinois","amount":"350"},{"url":"","amount":null}],"title":"\u003ch3\u003eContribute now to support our campaign!\u003c/h3\u003e","formId":"37e05ef4-3217-488c-b092-971a595421e8","bgColor":"bg3","buttons":[{"id":"256ad1fd-50f6-484b-b3cc-249c8673ec84","url":"","buttonUrl":"","buttonText":"your button text here"}],"eyebrow":"\u003cp\u003eDonate Today\u003c/p\u003e","heading":"\u003cp\u003eChip in to Ryan's Campaign!\u003c/p\u003e","variant":"DONATE","headline":"\u003cp\u003eChip in to Ryan's Campaign!\u003c/p\u003e","embedCode":"\u003ciframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/7ZO5OMrnfXM?si=SELxas9FU_WRYbhI\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen\u003e\u003c/iframe\u003e","marginTop":"top-large","buttonData":[{"url":"","amount":10},{"url":"","amount":25},{"url":"","amount":50},{"url":"","amount":100},{"url":"","amount":250},{"url":"","amount":null}],"buttonText":"your button text here","headlineOn":true,"bgColorType":"mediumDarker","description":"\u003cp\u003eWe have a chance to elect the youngest member of Congress in Illinois History\u003c/p\u003e","displayLogo":true,"enablePopup":true,"showEyebrow":false,"formProvider":"email","marginBottom":"bottom-large","submitBtnText":"Count me in","timeToTrigger":15,"showDisclaimer":false,"showDescription":true,"usePreviewImage":true,"videoDonateLogo":"","disclaimerDonate":"\u003cp\u003e\u003cstrong\u003eThis is placeholder copy - please change it or hide this section via the sidebar toggle button. \u003c/strong\u003eActBlue's Express Lane service will process donations immediately upon someone clicking your Run site donation buttons and therefore requires a disclaimer which you can \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://support.actblue.com/campaigns/actblue-express/actblue-express-lane/\"\u003eread about here\u003c/a\u003e. \u003c/p\u003e"},"type":"LANDING_POPUP","title":"Landing Popup","pageId":"a7f662cc-5e1d-4248-9a11-7068425e37f8","siteId":"f683133e-6417-446e-ac39-6479efbabbee","deleted":false,"variant":null,"createdAt":"2025-05-29T18:52:51.671+00:00","published":true,"updatedAt":"2026-03-02T16:51:03.873692+00:00","linkedBlockId":"33469742-912f-4721-9dc9-e734be8be548","postStructure":[],"primaryBlockId":null,"lastTranslatedAt":null},"7679edd2-2cc8-423c-8f44-20873d62e48c":{"id":"7679edd2-2cc8-423c-8f44-20873d62e48c","data":{"text":"\u003ch2\u003eIL-08\u003c/h2\u003e\u003cp\u003e\u003cstrong\u003eHere’s a map of our district \u003c/strong\u003e—don’t worry, the lines are correct, (we double-checked).\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWe cover some of the best parts of the Northwest Suburbs\u003c/strong\u003e: Schaumburg, Hoffman Estates, Bloomingdale, Hanover Park, Elk Grove Village, Itasca, Streamwood, Elgin, and Des Plaines. If you’ve ever been stuck in traffic on Route 59, yep—you’re probably in the district.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eThis is the heart of the Midwest. \u003c/strong\u003eIt’s where people work hard, look out for their neighbors, and still shovel each other’s driveways in a Chicago winter.\u003c/p\u003e\u003cp\u003eIt’s not just a district.\u0026nbsp;\u003cstrong\u003eIt’s home. \u003c/strong\u003eAnd it deserves leadership that feels like home, too.\u003c/p\u003e","bgColor":"bg0","eyebrow":"Eyebrow Text Here","headline":"Headline Text Here","marginTop":"top-large","headlineOn":false,"description":"Description Text Here","eyebrowSize":0,"showEyebrow":false,"headlineSize":0,"marginBottom":"bottom-large","descriptionSize":0,"showDescription":false},"type":"BASIC_TEXT","title":"Text","pageId":"5eb75eea-2f2a-43e8-9c8d-e6a83d28f2b6","siteId":"f683133e-6417-446e-ac39-6479efbabbee","deleted":false,"variant":null,"createdAt":"2025-05-31T03:17:27.539574+00:00","published":true,"updatedAt":"2026-03-02T16:51:03.873692+00:00","linkedBlockId":null,"postStructure":null,"primaryBlockId":null,"lastTranslatedAt":null},"053eccf2-e03d-4709-b423-3bc9db9cd920":{"id":"053eccf2-e03d-4709-b423-3bc9db9cd920","data":{"info":"\u003cp\u003eQuestions? Concerns? Need to Vent?\u003c/p\u003e\u003cp\u003eContact us at: \u003ca href=\"mailto:hello@ryanforillinois.com\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehello@ryanforillinois.com\u003c/a\u003e\u003c/p\u003e\u003cp\u003ePO Box 68492 Schaumburg, IL 60168\u003c/p\u003e","bgColor":"bg4","marginTop":"top-large","disclaimer":"\u003cp\u003eRYAN VETTICAD IS A FORMER DOJ EMPLOYEE AND AIR FORCE ROTC CADET. USE OF HIS JOB TITLES, AND PHOTOGRAPHS IN UNIFORM DOES NOT IMPLY ENDORSEMENT BY THE JUSTICE DEPT. OR THE DEPARTMENT OF DEFENSE.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003ePAID FOR BY RYAN FOR ILLINOIS\u003c/strong\u003e\u003c/p\u003e","quoteImage":"https://media.designedtorun.com/415b7455-174b-4f9e-9d05-7c9dbda44202/1654141695823-podpros-2mMhaoBGjCs-unsplash-.jpg","hideRunLink":false,"showPaidFor":true,"marginBottom":"bottom-large","poweredByText":"Powered by","showDescription":true,"shouldShowRunLogo":true},"type":"FOOTER","title":"Footer","pageId":"1f04f73e-4282-4e13-951a-80f26d67ec47","siteId":"f683133e-6417-446e-ac39-6479efbabbee","deleted":false,"variant":null,"createdAt":"2025-05-29T18:52:51.671+00:00","published":true,"updatedAt":"2026-03-02T16:51:03.873692+00:00","linkedB