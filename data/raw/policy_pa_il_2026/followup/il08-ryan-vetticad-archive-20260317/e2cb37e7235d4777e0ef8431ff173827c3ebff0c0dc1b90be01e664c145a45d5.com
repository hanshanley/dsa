stTranslatedAt":null},"a055c2d1-1dc4-41a5-afb2-a398d8c705ea":{"id":"a055c2d1-1dc4-41a5-afb2-a398d8c705ea","data":{"icons":[{"name":"IconCheckCircle1"}],"items":[{"id":"a78e0449-ca92-4143-a120-ae0f94072444","title":"\u003cp\u003eDemocratic Reform\u003c/p\u003e","updatedAt":"2025-06-23T01:02:05.719Z"},{"id":"c39f61a8-7454-41cd-8d1e-a598c81c3e05","title":"\u003cp\u003eAffordability\u003c/p\u003e","updatedAt":"2025-06-23T01:02:11.021Z"},{"id":"4e3a5395-4f74-456d-ab69-0a92a4d199b3","title":"\u003cp\u003eEnding Gun Violence\u003c/p\u003e","updatedAt":"2025-06-23T01:02:30.331Z"}],"bgColor":"bg1","buttons":[{"id":"ef628b1b-5dcd-4015-bb03-a14e8ff6c3ae","url":"","buttonText":"","openInNewTab":true}],"eyebrow":"Our priorities ","headline":"\u003cp\u003e\u003cu\u003eOur Platform\u003c/u\u003e\u003c/p\u003e","marginTop":"top-small","buttonText":"","headlineOn":true,"description":"\u003ch3\u003eFighting for Our Community\u003c/h3\u003e\u003cp\u003eThese are some of the \u003cstrong\u003etop priorities\u003c/strong\u003e our campaign is focused on.\u003c/p\u003e","eyebrowSize":0,"showEyebrow":false,"defaultIcons":[{"name":"checkMark"}],"headlineSize":0,"marginBottom":"bottom-large","descriptionSize":0,"showDescription":false,"secondaryEyebrow":"\u003cp\u003e\u003cspan style=\"color: var(--color-text); text-decoration-color: var(--color-text)\"\u003eI'm going to reduce Illinois property Taxes, make groceries and Healthcare affordable, ban congressional stock trading, and pass commonsense gun safety laws.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: var(--color-text); text-decoration-color: var(--color-text)\"\u003eTired of the Nonsense? So am I.\u003c/span\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: var(--color-text); text-decoration-color: var(--color-text)\"\u003eit's time for real action                 to make \u003cu\u003eyour\u003c/u\u003e life easier.\u003c/span\u003e\u003c/p\u003e","showFeaturedLink":false,"secondaryDescription":"\u003c