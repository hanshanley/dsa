      "speaker": "Claire Valdez",
      "role": "endorsed_candidate",
      "race_id": "race-d2aabb75a31f1e810737",
      "election_date": "2026-06-23",
      "topic": "housing",
      "subtopic": "permanent_affordable_and_housing_first",
      "stance": "support",
      "short_exact_quote": "The real solution is more permanently affordable housing",
      "locator": "question 12 answer",
      "representation_kind": "policy_position",
      "notes": "Full answer supports connecting unhoused people to resources, rejects shelter opposition, critiques inadequate shelters, and identifies permanent affordable housing as the long-term solution.",
      "attribution_notes": "Quote is from the candidate answer following question 12 answer in the body-verified US Congress NY-07 questionnaire.",
      "claim_summary": "Claire Valdez supports permanent affordable or Housing First housing rather than long-term reliance on inadequate shelters."
    },
    {
