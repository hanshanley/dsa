      "race_id": "race-39f265caadf4efc1cdd3",
      "election_date": "2026-06-23",
      "topic": "housing",
      "subtopic": "homelessness_housing_and_shelter_policy",
      "stance": "oppose",
      "short_exact_quote": "I would support making permanent and fully funding the Housing Access Voucher",
      "locator": "question 11 answer",
      "representation_kind": "policy_position",
      "notes": "Candidate answer to: 11. How will you represent the most vulnerable, including individuals experiencing homelessness and asylum seekers? Have you ever opposed any shelter in your district? Full answer retained in source body; the short anchor is interpreted only in that context.",
      "attribution_notes": "Quote is from the candidate answer following question 11 answer in the body-verified NY Assembly District 38 questionnaire.",
      "claim_summary": "David Orkin supports concrete assistance for unhoused or asylum-seeking residents and longer-term housing or shelter reforms."
