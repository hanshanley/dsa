\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2021/1/26/sdnyc-2021-special-election-questionnaires","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/6010bc752a4e6b321df743db/1611711071281/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"},{"id":"5ff75469695f6558bdceb562","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1610044584174,"updatedOn":1610044584314,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1610044584174,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2020/4/24/2020-primary-endorsements-pc76z","title":"2021 Elections: Information for Members &amp; Candidates","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1610044584179\" id=\"item-5ff75469695f6558bdceb562\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-e80f05c0edc634c99f21\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">For 35 years the Stonewall Democratic Club of NYC has played an important part in municipal, state, and federal elections. &nbsp;New York City will be going to the polls again in 2021.  In June we will vote for our candidates in New York City elections.  In addition, there will be special elections throughout the year.  SDNYC will once again:</p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\">Question candidates on issues important to the LGBTQ Community.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Present candidates to our membership for endorsement votes.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Support our endorsed candidates in the primaries.</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><a href=\"/2021-primary-endorsements\">Click here to learn more about our upcoming endorsement meetings.</a></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.