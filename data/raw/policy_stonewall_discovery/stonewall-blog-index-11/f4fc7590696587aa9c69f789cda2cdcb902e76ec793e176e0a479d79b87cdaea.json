aft":false,"title":"Home","navigationTitle":"Home"},"shoppingCart":{"websiteId":"534c4a50e4b02c0c8ea05e58","created":1790218387774,"entries":[],"shippingLocation":{},"taxLineItems":[],"coupons":[],"promoCodes":[],"appliedGiftCards":[],"cartType":1,"validCoupons":[],"invalidCoupons":[],"subtotalCents":0,"taxCents":0,"shippingCostCents":0,"discountCents":0,"giftCardRedemptionTotalCents":0,"grandTotalCents":0,"amountDueCents":0,"remainingBalanceCents":0,"totalQuantity":0,"purelyDigital":false,"hasDigital":false,"requiresShipping":false,"shippingOptions":[]},"shareButtons":{"twitter":true,"facebook":true,"reddit":true,"tumblr":true,"google":true,"pinterest":true,"linkedin":true},"showCart":false,"localizedStrings":{},"userAccountsContext":{"showSignInLink":false},"template":{"mobileStylesEnabled":true},"uiextensions":{"product-badge":"sqs-uiextensions-product-badge","product-body":"sqs-uiextensions-product-body","product-badge-mobile":"sqs-uiextensions-product-badge-mobile","product-body-mobile":"sqs-uiextensions-product-body-mobile","product-collection-item":"sqs-uiextensions-product-collection-item","scripts-enabled":false},"empty":false,"emptyFolder":false,"calendarView":false,"pagination":{"nextPage":true,"nextPageOffset":1725588360596,"nextPageUrl":"/?offset=1725588360596","pageSize":5,"prevPage":true,"prevPageOffset":1728494791867,"prevPageUrl":"/?offset=1728494791867&reversePaginate=true"},"items":[{"id":"6706bb0dec6035486bc92206","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1728494791867,"updatedOn":1729612726308,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1728494791867,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2024/10/9/phone-bank-with-sdnyc","title":"Phone Bank With SDNYC","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1728494791895\" id=\"item-6706bb0dec6035486bc92206\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-7afa0976a56bf5bc70f7\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">With just under a month left in this election, join SDNYC and the LGBTQ Community to hop on the telephone and make calls to get out the vote and make sure LGBTQ candidates win up and down the ballot. Training is available on arrival, so even if you've never phone banked before, you're welcome to come support the campaign. Let's get to work!</p><p class=\"\" style=\"white-space:pre-wrap;\">Join us every Thursday to Phone Bank for Kamala Harris! There are four weeks left, so grab some friends and come make calls Oct 10th, 17th. 24th, or 31st. <a href=\"https://events.democrats.org/event/694169/\">RSVP Here</a></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-yui_3_17_2_1_1728494330120_39455\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n        data-sqsp-image-classic-block-layout=\"inline\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:944px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n         