dn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2022/8/18/sdnycs-endorsed-candidates-in-the-august-23rd-primarynbsp","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/62fe57020b42227a73a3cf9d/1660835591801/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"},{"id":"62b747ae2563205d9195d49c","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1656178693593,"updatedOn":1656178693841,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1656178693593,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2022/6/25/t86l0mqjv8ncbssq7i1pwb22saara0","title":"","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1656178693600\" id=\"item-62b747ae2563205d9195d49c\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-border-radii=\"&#123;&quot;topLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;topRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;&#125;\" data-sqsp-block=\"text\" id=\"block-9b9e526a2018fcd9e594\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong><em>2022 PRIDE MARCH MEETING LOCATION &amp; TIME</em></strong></p><p class=\"\" style=\"white-space:pre-wrap;\">Given the devastating supreme court decision, Heritage of Pride organizers have agreed to have Planned Parenthood lead tomorrow's March and SDNYC will be joining the Planned Parenthood contingent. See below for more information about Heritage of Pride's decision to have Planned Parenthood lead the march.<br></p><h2 style=\"white-space:pre-wrap;\"><strong><em>Details For Tomorrow:</em></strong><br>Details are below &amp; on <a href=\"https://fb.me/e/1H6lYLcSX\" target=\"_blank\"><span style=\"text-decoration:underline\">Facebook</span></a>.</h2><p class=\"\" style=\"white-space:pre-wrap;\">Meeting Time: <strong>11AM</strong></p><p class=\"\" style=\"white-space:pre-wrap;\">Meeting Location: <strong>27th Street &amp; Broadway, enter through 6th Ave side</strong></p><h1 style=\"text-align:center;white-space:pre-wrap;\">STATEMENT FROM NYC PRIDE</h1><h1 style=\"white-space:pre-wrap;\"><br>PLANNED PARENTHOOD TO KICK OFF NYC PRIDE MARCH</h1><p class=\"\" style=\"white-space:pre-wrap;\">JUNE 25 2022</p><p class=\"\" style=\"white-space:pre-wrap;\"><br>NYC Pride is pleased to welcome <strong>Planned Parenthood</strong> as a featured marching contingent at today's NYC Pride March. Planned Parenthood will be the first group to step off at noon on Sunday June 26.<br><br>Yesterday's Supreme Court decision overturning nearly five decades of protections and reproductive freedom is devastating. This dangerous decision puts millions in harm\u2019s way, gives government control over our individual freedom to choose, and sets a disturbing precedent that puts many other constitutional rights and freedoms in jeopardy.<br><br>As millions gather for LGBTQIA+ Pride this weekend in New York City and cities across the country, our voices will be heard - for the LGBTQ people impacted and the millions with whom we stand in solidarity.<br><br>Pride was born of protest and will always be a space to fight injustice and discrimination. Join us as we advocate for bodily autonomy at this year's NYC Pride March.<br></p><p class=\"\" style=\"white-space:pre-wrap;\"><br><br>ABOUT HERITAGE OF PRIDE Heritage of Pride, Inc. is the volunteer-directed organization behind the official NYC Pride roster of events. Heritage of Pride\u2019s mission is to work toward a future without discrimination where all people have equal rights under the law. We do this by producing LGBTQIA+ Pride events that inspire, educate, commemorate, and celebrate our diverse community.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2022/6/25/t86l0mqjv8ncbssq7i1pwb22saara0","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/62b747ae2563205d9195d49c/1656178693841/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"promotedBlock":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Promoted Block\" data-type=\"promoted-block\" id=\"promoted-block-62b747ae2563205d9195d49c\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block image-block sqs-block-image\" dat