p class=\"\" style=\"white-space:pre-wrap;\">Question candidates on issues important to the LGBTQ Community.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Present candidates to our membership for endorsement votes.</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Support our endorsed candidate in the primary election.</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><a href=\"/2022-primary-election-info\">Click here for all the details</a></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2022/2/17/2022-primary-election-information-amp-process","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/620e5b65e9ceb04fce38b507/1645108138742/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"}],"pagePreviewContext":{"isPreviewMode":false,"memberAccessUrl":"/blog?format=json&offset=1669828178995&requestAccess=true"}}