aft":false,"title":"Home","navigationTitle":"Home"},"shoppingCart":{"websiteId":"534c4a50e4b02c0c8ea05e58","created":1790218382168,"entries":[],"shippingLocation":{},"taxLineItems":[],"coupons":[],"promoCodes":[],"appliedGiftCards":[],"cartType":1,"validCoupons":[],"invalidCoupons":[],"subtotalCents":0,"taxCents":0,"shippingCostCents":0,"discountCents":0,"giftCardRedemptionTotalCents":0,"grandTotalCents":0,"amountDueCents":0,"remainingBalanceCents":0,"totalQuantity":0,"purelyDigital":false,"hasDigital":false,"requiresShipping":false,"shippingOptions":[]},"shareButtons":{"twitter":true,"facebook":true,"reddit":true,"tumblr":true,"pinterest":true,"google":true,"linkedin":true},"showCart":false,"localizedStrings":{},"userAccountsContext":{"showSignInLink":false},"template":{"mobileStylesEnabled":true},"uiextensions":{"product-badge":"sqs-uiextensions-product-badge","product-body":"sqs-uiextensions-product-body","product-badge-mobile":"sqs-uiextensions-product-badge-mobile","product-body-mobile":"sqs-uiextensions-product-body-mobile","product-collection-item":"sqs-uiextensions-product-collection-item","scripts-enabled":false},"empty":false,"emptyFolder":false,"calendarView":false,"pagination":{"nextPage":true,"nextPageOffset":1771288211159,"nextPageUrl":"/?offset=1771288211159","pageSize":5,"prevPage":true,"prevPageOffset":1775670289369,"prevPageUrl":"/?offset=1775670289369&reversePaginate=true"},"items":[{"id":"69d692c826728035a8b7df2e","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1775670289369,"updatedOn":1775670289606,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1775670289369,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2026/4/8/2026-state-legislature-endorsement-meeting","title":"2026 State Legislature Endorsement Meeting","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-u