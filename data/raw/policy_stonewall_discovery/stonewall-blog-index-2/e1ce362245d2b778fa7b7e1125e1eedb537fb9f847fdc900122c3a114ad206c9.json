59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2026/4/8/2026-state-legislature-endorsement-meeting","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/69d692c826728035a8b7df2e/1775670289606/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"},{"id":"69a8a806577fd370831aec2e","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1772661390037,"updatedOn":1777646387569,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1772661390037,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2026/3/4/sdnyc-elects-their-2026-executive-board","title":"SDNYC Elects Our 2026 Executive Board","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1772661328099\" id=\"item-69a8a806577fd370831aec2e\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-d547a60fc4b1d01f8025\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">The Stonewall Democratic Club of NYC is pleased to share our newly elected 2026 Executive Board. We are thrilled to have such a dynamic leadership lead who will continue to work with SDNYC members and the wider LGBTQ+ community to keep fighting for our rights. Want to get more involved in SDNYC? Become a member, sign up for eblasts, and join us March 25th for our next General Meeting at 6:30 PM at the LGBT Center on 13th Street.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div></div></div>","excerpt":"","customContent":null,"likeCount":2,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2026/3/4/sdnyc-elects-their-2026-executive-board","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/69a8a806577fd370831aec2e/1777646387569/","contentType":"image/png","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"},{"id":"69a21c2c0d454419940cf4d5","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1772233030321,"updatedOn":1772233136569,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1772233030321,"authorId":"534c4a4fe4b0aea44780ee59","systemDataId":"1772233001631-NPFFV78HWVV2C1OGXVHW","systemDataVariants":"1080x1350","systemDataSourceType":"PNG","filename":"ENDORSEMENTS 2025.png","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"6994f9","topRightAverage":"6894f9","bottomLeftAverage":"531dc8","bottomRightAverage":"6839cf","centerAverage":"5e59e0","suggestedBgColor":"6b65c4"},"urlId":"2026/2/27/sdnyc-endorsement-city-council-district-3","title":"SDNYC Endorsement City Council District 3","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1772233022123\" id=\"item-69a21c2c0d454419940cf4d5\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-469031479848646072dc\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">On Wednesday February 25th, the Stonewall Democratic Club of NYC heard from candidates seeking election to the 3rd District City Council Seat. The non-partisan special election will take place on Tuesday, April 28th, with early voting beginning on April 18th. Find your poll site <a href=\"https://vote.nyc/page/find-your-poll-site\">here</a>. As the LGBTQ community faces attacks on our health, safety, rights, and dignity, it is crucial that we elect representatives who will fight back and support our community. That is why SDNYC is proud to endorse Carl Wilson in the special election. </p><p class=\"\" style=\"white-space:pre-wrap;\">LGBTQ representation in government is essential to building policies that reflect and protect our full community. Electing Carl would strengthen queer visibility at City Hall and ensure that the lived experiences of Queer New Yorkers directly inform decisions about housing, safety, and equity. Carl has the proven track record delivering results for constituents and advancing policies that uplift the Westside of Manhattan.</p><p class=\"\" data-rte-preserve-empty=\"true\" style=\"white-space:pre-wrap;\"></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div></div></div>","excerpt":"","customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2026/2/27/sdnyc-endorsement-city-council-district-3","assetUrl":"https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/1772233001631-NPFFV78HWVV2C1OGXVHW/ENDORSEMENTS+2025.png","contentType":"image/png","items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1080x1350","recordTypeLabel":"text"},{"id":"699de63b86942309331435fb","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1771955803655,"updatedOn":1771955803813,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1771955803655,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2026/2/24/city-council-district-3-special-election-endorsement-meeting","title":"City Council District 3 Special Election Endorsement Meeting","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1771955803660\" id=\"item-699de63b86942309331435fb\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-4cdacb19afe7b8574c71\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>On Wed. Feb 25th, SDNYC will host our regularly scheduled February General Meeting at the Church of the Village (</strong>201 W 13th St, New York, NY 10011).&nbsp;We will hear from candidates&nbsp;for the special election Council District 3:</p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\">Carl Wilson</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Jamin Enquist</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Layla Law-Gisko</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Leslie&nbsp;Boghosian Murphy</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\">Lindsey Boylan&nbsp;&nbsp;</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\">Candidates have submitted <a href=\"https://sdnyc.us16.list-manage.com/track/click?u=eb08ffbd9b1e8af996fbb0e67&amp;id=c1db6dbf61&amp;e=91d965368e\" target=\"_blank\"><span style=\"text-decoration:underline\">answers to our questionnaire here</span></a>. We encourage you to read through their answers, then join us on Wednesday to hear them speak! After the meeting, 2026 SDNYC Members will be emailed a ballot to vote (along with a vote on amendments to the SDNYC Constitution).</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-yui_3_17_2_1_1771955758939_35865\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-none\n          individual-animation-none\n          individual-text-animation-none\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n        data-sqsp-image-classic-block-layout=\"inline\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1080px;\"\n   