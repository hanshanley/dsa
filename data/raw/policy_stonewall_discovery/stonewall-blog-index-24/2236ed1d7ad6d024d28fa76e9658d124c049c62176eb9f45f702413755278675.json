m/content/v1/534c4a50e4b02c0c8ea05e58/1582726653824-PVCHKM4VWDMYI217W6S9/81038685_2959136244097391_3334710675602669568_n.jpg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/1582726653824-PVCHKM4VWDMYI217W6S9/81038685_2959136244097391_3334710675602669568_n.jpg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/1582726653824-PVCHKM4VWDMYI217W6S9/81038685_2959136244097391_3334710675602669568_n.jpg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/1582726653824-PVCHKM4VWDMYI217W6S9/81038685_2959136244097391_3334710675602669568_n.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n          \n          <figcaption data-sqsp-image-classic-block-caption-container class=\"image-caption-wrapper\">\n            <div class=\"image-caption\"><p class=\"\">On February 26th at 8pm at the The Lesbian, Gay, Bisexual &amp; Transgender Community Center, Stonewall Democratic Club of New York City | SDNYC will hold our monthly meeting.<br><br>Join us as we vote to endorse for the Queens Borough President Special Election. (For membership requirements to vote, please go to <a href=\"http://sdnyc.org/?fbclid=IwAR0gIAuTAWXsGqWSqkaGlfbUs3EHpyemnUF0Pm_--OONk_tr8gWnLc69aDE\" target=\"_blank\">http://sdnyc.org.</a>) Responses to our Endorsement Questionnaire can be found <a href=\"https://l.facebook.com/l.php?h=AT3yrm4x9y74Hn-JsAA6PbwRenMw6VGUE-5mr_j-VeUbX-1T9eTUpf5f-0vdPJV7z1opJ_LWHiKbLuF3vp_CH2yCJMmC-8bi9pB0CCGS7DMrXwk0ytO7h8yc9sgbpuvPyB4J4_XQuv57mzAS4qY18PlbmA&amp;u=https%3A%2F%2Fdocs.google.com%2Fdocument%2Fd%2F1iXY8GhErj4oh3J7n_Xk2W6UoCTaWCYxNfPDM5eLVe4Y%2Fedit%3Fusp%3Dsharing%26fbclid%3DIwAR1fi1_XAsDtfI5tRvISr0l-I6K_GKiQDqCYqAJgANxiiAFqbnEVcmOQmW0\">HERE</a>.</p><p class=\"\"></p><p class=\"\">We'll also have brief community updates, including a look at the coming political/legislative calendar, election of board members and more.  <br><br>This meeting is free and open to members of the public so please share this invite with anyone who might be interested!</p></div>\n          </figcaption>\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div></div></div></div>","promotedBlockType":"image","recordTypeLabel":"text"},{"id":"5e2f1c56c864b450d75ce626","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1580146036687,"updatedOn":1580146037016,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1580146036687,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2020/1/27/sdnyc-endorses-elizabeth-warren-for-president","title":"SDNYC ENDORSES:  ELIZABETH WARREN FOR PRESIDENT","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1580146036706\" id=\"item-5e2f1c56c864b450d75ce626\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-5e73aa8df924fab62bf4\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">The membership of SDNYC met Wednesday, January 22 and voted to endorse Elizabeth Warren for President of the United States.   From taking on corruption to healthcare, from childcare to school debt, Elizabeth Warren has a plan to bring big structural change!  Elizabeth Warren understands the LGBTQ community and its needs, including our most marginalized, and we\u2019re proud to support her!</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74