aft":false,"title":"Home","navigationTitle":"Home"},"shoppingCart":{"websiteId":"534c4a50e4b02c0c8ea05e58","created":1790218395661,"entries":[],"shippingLocation":{},"taxLineItems":[],"coupons":[],"promoCodes":[],"appliedGiftCards":[],"cartType":1,"validCoupons":[],"invalidCoupons":[],"subtotalCents":0,"taxCents":0,"shippingCostCents":0,"discountCents":0,"giftCardRedemptionTotalCents":0,"grandTotalCents":0,"amountDueCents":0,"remainingBalanceCents":0,"totalQuantity":0,"purelyDigital":false,"hasDigital":false,"requiresShipping":false,"shippingOptions":[]},"shareButtons":{"twitter":true,"facebook":true,"reddit":true,"tumblr":true,"pinterest":true,"google":true,"linkedin":true},"showCart":false,"localizedStrings":{},"userAccountsContext":{"showSignInLink":false},"template":{"mobileStylesEnabled":true},"uiextensions":{"product-badge":"sqs-uiextensions-product-badge","product-body":"sqs-uiextensions-product-body","product-badge-mobile":"sqs-uiextensions-product-badge-mobile","product-body-mobile":"sqs-uiextensions-product-body-mobile","product-collection-item":"sqs-uiextensions-product-collection-item","scripts-enabled":false},"empty":false,"emptyFolder":false,"calendarView":false,"pagination":{"nextPage":true,"nextPageOffset":1579551724531,"nextPageUrl":"/?offset=1579551724531","pageSize":5,"prevPage":true,"prevPageOffset":1582823644909,"prevPageUrl":"/?offset=1582823644909&reversePaginate=true"},"items":[{"id":"5e57f8a2a171bb5ca70087d5","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1582823644909,"updatedOn":1582823645091,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1582823644909,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2020/2/27/congratulations-to-new-sdnyc-officers","title":"Congratulations to New SDNYC Officers!","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1582823644974\" id=\"item-5e57f8a2a171bb5ca70087d5\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1582823523484_26913\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">SDNYC Friends and Family,<br>&nbsp;<br>I am excited and proud to share that last night&nbsp;<strong>Brian Romero</strong>&nbsp;was elected to SDNYC President. &nbsp;Joining Brian in club leadership are:</p><ul data-rte-list=\"default\"><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Charlotte Martin</strong>,&nbsp;Executive Vice President</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Melissa Sklarz</strong>,&nbsp;Vice President</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Jimmy Rivera</strong>,&nbsp;Vice President</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Gabriel Lewenstein</strong>,&nbsp;Treasurer</p></li><li><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Ruben Porras-Sanchez</strong>, Secretary</p></li></ul><p class=\"\" style=\"white-space:pre-wrap;\"><br>I am confident that under Brian and his team's leadership, the Club will continue to flourish, evolve, and continue the work we have done together over the past 34 years: &nbsp;fighting for equality for all. &nbsp;<br><br>In today\u2019s political climate, it is critical that SDNYC remain vigilant in advocating for the LGBTQ community, an effort that comes not from the top down, but from the bottom up. &nbsp;<strong>This is your club,&nbsp;</strong>and in the coming months you'll be called upon to join the fight. &nbsp;Your voice, your energy, and your spirit combine to forge our collective strength.<br><br>It has been an honor to serve two terms as this club's President.&nbsp;I'm proud of the progress we've seen in the past two years in both the city and state and the role this club has played. &nbsp;And&nbsp;I'm incredibly grateful for the friendship, camaraderie, and kindness I've been shown. &nbsp;I'm not leaving this fight, and I can't wait to see what's next!<br><br>To the future!<br><br>Rod Townsend<br><a href=\"mailto:rod@rodtownsend.com?subject=SDNYC\" target=\"_blank\">rod@rodtownsend.com</a></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":1,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2020/2/27/congratulations-to-new-sdnyc-officers","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/5e57f8a2a171bb5ca70087d5/1582823645091/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"},{"id":"5e567e54dd4cda3aa2e88fce","collectionId":"53555429e4b0dae1be59e72f","recordType":1,"addedOn":1582726822619,"updatedOn":1582726822762,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1582726822619,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoin