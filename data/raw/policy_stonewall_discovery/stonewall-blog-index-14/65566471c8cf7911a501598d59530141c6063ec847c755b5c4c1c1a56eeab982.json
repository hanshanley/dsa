ries":[],"workflowState":1,"publishOn":1714061785452,"authorId":"534c4a4fe4b0aea44780ee59","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"urlId":"2024/4/24/2024-nys-assembly-endorsements","title":"2024 NYS Assembly Endorsements","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" data-updated-on=\"1713989297956\" id=\"item-66295eab2caf1e33255dea00\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-0de11ca18b928aa8cb35\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">Last night, our members heard from candidates running for New York State Assembly. Stonewall Democrats of NYC is proud to endorse:</p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Assembly District 25 </strong>- Nily Rozic<br><strong>Assembly District 28 </strong>- Andrew Hevesi <strong><br>Assembly District 29</strong> - Alicia Hyndman<strong><br>Assembly District 30</strong> - Steven Raga<br><strong>Assembly District 31</strong> - Khaleel Anderson<strong><br>Assembly District 34 </strong>- Jessica Gonz\u00E1lez-Rojas<strong><br>Assembly District 35 </strong>- Larinda Hooks<strong><br>Assembly District 37 </strong>- Johanna Carmona<strong><br>Assembly District 39 </strong>- Catalina Cruz <strong><br>Assembly District 40</strong> - Yi Andy Chen<strong><br>Assembly District 43 - </strong>Brian Cunningham <br><strong>Assembly District 44 </strong>- Robert Carroll<strong><br>Assembly District 46 - </strong>Christopher McCreight<strong><br>Assembly District 50 </strong>- Emily Gallagher <br><strong>Assembly District 52 - </strong>Jo Anne Simon<br><strong>Assembly District 55- </strong>Latrice Walker <br><strong>Assembly District 66</strong> - Deborah Glick<strong><br>Assembly District 67</strong> - Linda Rosenthal<strong><br>Assembly District 68</strong> - Tied: Eddie Gibbs &amp; Tamika Mapp <strong><br>Assembly District 69</strong> - Micah Lasher<strong><br>Assembly District 70</strong> - Jordan Wright <strong><br>Assembly District 71 - </strong>Al Taylor<strong><br>Assembly District 73</strong> - Alex Bores<strong><br>Assembly District 74</strong> - Harvey Epstein<strong><br>Assembly District 75</strong> - Tony Simone<br><strong>Assembly District 76 - </strong>Rebecca Seawright<strong><br>Assembly District 77 </strong>- Landon Dais<strong><br>Assembly District 78</strong> - George Alvarez<strong><br>Assembly District 81 </strong>- Jeffrey Dinowitz<strong><br>Assembly District 82</strong> - Michael Benedetto<strong><br>Assembly District 83</strong> - Carl Heastie<br><strong>Assembly District 87</strong> -  Karines Reyes<strong><br><br>Congratulations to all our endorsed candidates - </strong>and thank you to all who have engaged with our club to emphasize the importance of LGBTQ issues in New York.  Primary Day is June 25th, with early voting June 15 \u2013 23.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div></div></div>","excerpt":"","location":{"mapZoom":12.0,"mapLat":40.7143528,"mapLng":-74.0059731,"markerLat":40.7143528,"markerLng":-74.0059731,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/a