a63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=300w 300w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/2890fa63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=500w 500w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/2890fa63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=750w 750w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/2890fa63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/2890fa63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/534c4a50e4b02c0c8ea05e58/2890fa63-aa9c-4d5b-8a15-bdeeb095d534/unnamed.png?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-9bc952a7c9fe2b3b81dc\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\"><strong>Join us on&nbsp;April 24th at&nbsp;6:30pm at the LGBTQ+ Center&nbsp;in Room 110 </strong>for our April Endorsement Meeting, where we will hear&nbsp;from candidates running for New York State Assembly! RSVP on Facebook for event updates, including candidate questionnaires:&nbsp;<a href=\"https://sdnyc.us16.list-manage.com/track/click?u=eb08ffbd9b1e8af996fbb0e67&amp;id=528a04a97d&amp;e=91d965368e\" target=\"_blank\"><span style=\"text-decoration:underline\"><strong>https://fb.me/e/24HpuvrHh</strong></span></a><br><br>See below for information about renewing your membership in advance.<br><br><em>Stay Tuned: On May 1st at 8:00pm, SDNYC will hold a second Endorsement Meeting to hear from candidates for NYS Senate and US Congress.</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><span style=\"text-decoration:underline\"><strong>SDNYC Members: Renew Your Membership to Vote</strong></span></p><p class=\"\" style=\"white-space:pre-wrap;\"><br><strong>2024 will be a critical year for elections in our city, state, and country</strong>. SDNYC is committed to endorsing, campaigning for, and electing representatives who will fight to advance the rights, priorities, and ideals of the LGBTQ community.</p><p class=\"\" style=\"white-space:pre-wrap;\">Per the SDNYC Constitution and By Laws,&nbsp;individuals who are 2024&nbsp;SDNYC Members will be eligible to vote. Members who were in good standing within the previous two calendar years may pay the current year\u2019s dues and be members in good standing, including the right to immediately vote in endorsements. Individuals who were not dues paying members of&nbsp;SDNYC&nbsp;in 2022 or 2023&nbsp;must have paid the Club's 2024 membership dues <strong>90 days </strong>before the club endorsement vote (April 24th) ... so if you were a 2022&nbsp;or 2023 Member of Stonewall Dems, <a href=\"https://sdnyc.us16.list-manage.com/track/click?u=eb08ffbd9b1e8af996fbb0e67&amp;id=95cba8f1ad&amp;e=91d965368e\" title=\"Renew Your SDNYC Membership Now!\" target=\"_blank\"><strong>renew your SDNYC Membership now!</strong></a></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div></div></div>","excerpt":"","customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"author":{"id":"534c4a4fe4b0aea44780ee59","displayName":"Stonewall Democrats","firstName":"Stonewall","lastName":"Democrats","avatarUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w","avatarId":"573b0f0c07eaa0aeb80e6bfd","bio":"","avatarAssetUrl":"https://images.squarespace-cdn.com/content/v2/namespaces/memberAccountAvatars/libraries/534c4a4fe4b0aea44780ee59/ac0ae7a14bad4258af35b228d6617dc7/ac0ae7a14bad4258af35b228d6617dc7.jpeg?format=300w"},"fullUrl":"/blog/2024/4/20/april-endorsement-meeting-for-nys-assembly-candidates","assetUrl":"https://static1.squarespace.com/static/534c4a50e4b02c0c8ea05e58/53555429e4b0dae1be59e72f/66245e5c2d34534ffcda0238/1713659753707/","contentType":"text/html","items":[],"pushedServices":{},"pendingPushedServices":{},"recordTypeLabel":"text"}],"pagePreviewContext":{"isPreviewMode":false,"memberAccessUrl":"/blog?format=json&offset=1717556401605&requestAccess=true"}}