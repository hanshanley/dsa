				<div class="et_pb_text_inner">
					<h2>Vote on March 3, 2020</h2>
				</div>
			</div> <!-- .et_pb_text --><div class="et_pb_module et_pb_text et_pb_text_16 et_pb_bg_layout_light  et_pb_text_align_center">
				
				
				<div class="et_pb_text_inner">
					<p style="text-align: center;">Not sure which district you’re in?<br />
<strong><a href="https://wrm.capitol.texas.gov/home" target="_blank" rel="noopener noreferrer">Find Your District</a></strong></p>
