    {
      "segment_id": "d53579b02392c18d95104e72",
      "document_id": "hp20-williamson-hub",
      "segment_kind": "paragraph",
      "index": "11",
      "locator": "paragraph 11",
      "text": "THE ISSUES",
      "sha256": "e023c5e7f0c75019eae415b9d806eb61ab13c5baae273ee1a3943dbfc6c2ba00"
    },
    {
      "segment_id": "a38e28e43a76318fee4b769c",
      "document_id": "hp20-williamson-hub",
      "segment_kind": "paragraph",
      "index": "12",
      "locator": "paragraph 12",
      "text": "I hope you will find this campaign to be something that ups your own experience of citizenship, not only for the purposes of electing me president but for the sake of forging a new chapter in our history.",
      "sha256": "9096af22341885c7f0ad7d3e529d1c1cbc3d27b8b8bb3274225bad6b7a160b8f"
    },
    {
      "segment_id": "bd07b0d8a8c52009d81e5635",
      "document_id": "hp20-williamson-hub",
      "segment_kind": "paragraph",
      "index": "13",
      "locator": "paragraph 13",
      "text": "Our task is to generate a massive wave of energy, fueled and navigated by we the people, so powerful as to override all threats to our democracy. Where fear has been harnessed for political purposes, our task is to harness love.",
      "sha256": "0b0d1a50db36d9df44c051af9599db5688118a21b8431135faffe8fd02a02347"
    },
    {
      "segment_id": "63c912ee005a27b7a7e0d3d5",
      "document_id": "hp20-williamson-hub",
      "segment_kind": "paragraph",
      "index": "14",
      "locator": "paragraph 14",
      "text": "May all of us rise to a higher level of participation in the life of this country. In order to make America better, all of us must be better now: more educated, more involved, and more conscious citizens of the United States.",
      "sha256": "1af924f774cd048c1e661f9222de3384bf3de95c1890f439effac92cad8b55cd"
    },
    {
